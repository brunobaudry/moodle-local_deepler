{{!
    @template local_deepler/files_settings_modal

    Modal body for per-file custom translation settings.
}}
<div class="files-settings-modal-content" data-fileid="{{fileid}}">
    <!-- Formality -->
    <div class="mb-3">
        <label class="form-label font-weight-bold d-block">{{#str}}formality,local_deepler{{/str}}</label>
        <select class="form-control custom-select modal-formality-select" id="modal_formality_{{fileid}}">
            <option value="">{{#str}}formalitydefault,local_deepler{{/str}} ({{#str}}useglobal,local_deepler{{/str}})</option>
            <option value="default">{{#str}}formalitydefault,local_deepler{{/str}}</option>
            <option value="prefer_more">{{#str}}formalityprefermore,local_deepler{{/str}}</option>
            <option value="prefer_less">{{#str}}formalitypreferless,local_deepler{{/str}}</option>
            <option value="more">{{#str}}formalitymore,local_deepler{{/str}}</option>
            <option value="less">{{#str}}formalityless,local_deepler{{/str}}</option>
        </select>
    </div>

    <!-- Glossary -->
    <div class="mb-3">
        <label class="form-label font-weight-bold d-block">{{#str}}glossary:name,local_deepler{{/str}}</label>
        <select class="form-control custom-select modal-glossary-select" id="modal_glossary_{{fileid}}">
            <option value="">{{#str}}glossary:notselected,local_deepler{{/str}}</option>
            {{#glossaries}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
            {{/glossaries}}
        </select>
        <small class="form-text text-muted">{{#str}}glossary:selectplaceholder,local_deepler{{/str}}</small>
    </div>

    <!-- Minification -->
    <div class="mb-3">
        <label class="form-label font-weight-bold d-block">{{#str}}files:minification,local_deepler{{/str}}</label>
        <div class="form-check form-switch custom-control custom-switch mt-1">
            <input type="checkbox" class="form-check-input custom-control-input modal-minification-checkbox" id="modal_minification_{{fileid}}" {{#minification}}checked{{/minification}}>
            <label class="form-check-label custom-control-label small text-muted" for="modal_minification_{{fileid}}">
                {{#str}}files:minification_desc,local_deepler{{/str}}
            </label>
        </div>
    </div>
</div>
