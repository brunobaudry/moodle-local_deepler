{{!
    @template local_deepler/files_settings_modal

    Form fields for file translation settings (used in page header modal and per-file modal).
    Supports a prefix parameter for scoping input IDs, labels, and names.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * fileid
    * prefix
    * formality_default
    * formality_prefer_more
    * formality_prefer_less
    * formality_more
    * formality_less
    * glossaries
    * minification

    Example context (json):
    {
        "fileid": 101,
        "prefix": "modal_",
        "formality_default": true,
        "formality_prefer_more": false,
        "formality_prefer_less": false,
        "formality_more": false,
        "formality_less": false,
        "glossaries": [
            {
                "id": "123",
                "name": "Standard Glossary",
                "selected": true
            }
        ],
        "minification": true
    }
}}
<div class="files-settings-modal-content {{#fileid}}files-settings-modal-content-row{{/fileid}}" {{#fileid}}data-fileid="{{fileid}}"{{/fileid}}>
    <div class="row">
        <!-- Formality -->
        <div class="col-md-4 mb-3" id="{{#prefix}}{{prefix}}{{/prefix}}local_deepler_formality_container">
            <label class="form-label font-weight-bold d-block" for="{{#prefix}}{{prefix}}{{/prefix}}formality{{#fileid}}_{{fileid}}{{/fileid}}">{{#str}}formality,local_deepler{{/str}}</label>
            <select class="form-control custom-select modal-formality-select" id="{{#prefix}}{{prefix}}{{/prefix}}formality{{#fileid}}_{{fileid}}{{/fileid}}" data-id="local_deepler/formality" name="{{#prefix}}{{prefix}}_{{/prefix}}local_deepler/formality">
                <option value="default" {{#formality_default}}selected{{/formality_default}}>{{#str}}formalitydefault,local_deepler{{/str}}</option>
                <option value="prefer_more" {{#formality_prefer_more}}selected{{/formality_prefer_more}}>{{#str}}formalityprefermore,local_deepler{{/str}}</option>
                <option value="prefer_less" {{#formality_prefer_less}}selected{{/formality_prefer_less}}>{{#str}}formalitypreferless,local_deepler{{/str}}</option>
                <option value="more" {{#formality_more}}selected{{/formality_more}}>{{#str}}formalitymore,local_deepler{{/str}}</option>
                <option value="less" {{#formality_less}}selected{{/formality_less}}>{{#str}}formalityless,local_deepler{{/str}}</option>
            </select>
        </div>

        <!-- Glossary -->
        <div class="col-md-4 mb-3" id="{{#prefix}}{{prefix}}{{/prefix}}local_deepler_glossary_container">
            <label class="form-label font-weight-bold d-block" for="{{#prefix}}{{prefix}}{{/prefix}}glossary{{#fileid}}_{{fileid}}{{/fileid}}">{{#str}}glossary:name,local_deepler{{/str}}</label>
            <select class="form-control custom-select modal-glossary-select" id="{{#prefix}}{{prefix}}{{/prefix}}glossary{{#fileid}}_{{fileid}}{{/fileid}}" data-id="local_deepler/glossary_id" name="{{#prefix}}{{prefix}}_{{/prefix}}local_deepler/glossary_id">
                <option value="">{{#str}}glossary:notselected,local_deepler{{/str}}</option>
                {{#glossaries}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/glossaries}}
            </select>
            <small class="form-text text-muted">{{#str}}glossary:selectplaceholder,local_deepler{{/str}}</small>
        </div>

        <!-- Minification -->
        <div class="col-md-4 mb-3" id="{{#prefix}}{{prefix}}{{/prefix}}local_deepler_minification_container">
            <label class="form-label font-weight-bold d-block" for="{{#prefix}}{{prefix}}{{/prefix}}minification{{#fileid}}_{{fileid}}{{/fileid}}">{{#str}}files:minification,local_deepler{{/str}}</label>
            <div class="form-check form-switch custom-control custom-switch mt-1">
                <input type="checkbox" class="form-check-input custom-control-input modal-minification-checkbox" id="{{#prefix}}{{prefix}}{{/prefix}}minification{{#fileid}}_{{fileid}}{{/fileid}}" data-id="local_deepler/minification" {{#minification}}checked{{/minification}}>
                <label class="form-check-label custom-control-label small text-muted" for="{{#prefix}}{{prefix}}{{/prefix}}minification{{#fileid}}_{{fileid}}{{/fileid}}">
                    {{#str}}files:minification_desc,local_deepler{{/str}}
                </label>
            </div>
        </div>
    </div>
</div>
