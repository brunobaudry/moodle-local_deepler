{{!
    @template local_deepler/files_open_duplicate_link

    Link to open duplicated activity.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * newcmurl

    Example context (json):
    {
        "newcmurl": "https://example.com/mod/resource/view.php?id=123"
    }
}}
<div class="mt-1 open-duplicate-link">
    <a href="{{newcmurl}}" target="_blank" class="btn btn-xs btn-outline-success py-0 px-1 small">
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> {{#str}} files:openactivity, local_deepler {{/str}}
    </a>
</div>
