{{!
    @template local_deepler/files_translation_item

    Template for a single translation entry inside the file accordion list.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * targetlang
    * filename
    * timecreated
    * newcmurl
    * str_billedchars
    * statusbadge
    * statusstr
    * validationtable (example only, wraps the row for standalone validation)

    Example context (json):
    {
        "validationtable": true,
        "targetlang": "DE",
        "filename": "document_de.pdf",
        "timecreated": "10 Nov 2026, 14:30",
        "newcmurl": "https://example.com/mod/resource/view.php?id=124",
        "str_billedchars": "1,250 chars",
        "statusbadge": "badge-success bg-success text-white",
        "statusstr": "Completed"
    }
}}
{{#validationtable}}<table>
    <caption>{{#str}}files:translated, local_deepler{{/str}}</caption>
<tbody>{{/validationtable}}
<tr class="translation-item bg-light">
    <td></td>
    <td class="align-middle">
        {{#newcmurl}}
            <a href="{{newcmurl}}" target="_blank" rel="noopener noreferrer" class="btn btn-xs btn-outline-success py-0 px-2 small">
                <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                {{#str}} files:openactivity, local_deepler {{/str}} {{#str}} ariatargetblank, local_deepler {{/str}}
            </a>
        {{/newcmurl}}
        {{^newcmurl}}
            {{#newfileurl}}
                <a href="{{newfileurl}}" target="_blank" rel="noopener noreferrer" class="btn btn-xs btn-outline-primary py-0 px-2 small">
                    <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                    {{#str}} preview, core {{/str}} {{#str}} ariatargetblank, local_deepler {{/str}}
                </a>
            {{/newfileurl}}
        {{/newcmurl}}
    </td>
    <td class="align-middle"><span class="font-weight-bold fw-bold">{{filename}}</span></td>
    <td class="align-middle small text-muted">{{str_billedchars}}</td>
    <td></td>
    <td class="align-middle"><span class="badge badge-primary bg-primary text-white">{{targetlang}}</span></td>
    <td></td>
    <td class="align-middle">
        <span class="badge {{statusbadge}} px-2">{{statusstr}}</span>
        <span class="small text-muted d-block">{{timecreated}}</span>
    </td>
</tr>
{{#validationtable}}</tbody></table>{{/validationtable}}
