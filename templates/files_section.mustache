{{!
    @template local_deepler/files_section

    Template for a section block in Deepler files page.
}}
<div class="card mb-4 files-section-card" data-sectionid="{{sectionid}}">
    <div class="card-header bg-light">
        <h5 class="mb-0">{{sectionname}}</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 40px;" class="text-center">#</th>
                        <th>{{#str}} files:activityname, local_deepler {{/str}}</th>
                        <th>{{#str}} files:filename, local_deepler {{/str}}</th>
                        <th style="width: 90px;">{{#str}} files:filesize, local_deepler {{/str}}</th>
                        <th style="width: 80px;">{{#str}} files:sourcelang, local_deepler {{/str}}</th>
                        <th style="width: 220px;">{{#str}} files:selecttargets, local_deepler {{/str}}</th>
                        <th style="width: 200px;">{{#str}} files:status, local_deepler {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                        {{> local_deepler/files_row }}
                    {{/rows}}
                </tbody>
            </table>
        </div>
    </div>
</div>
