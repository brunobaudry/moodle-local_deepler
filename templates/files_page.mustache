{{!
    @template local_deepler/files_page

    Template for Deepler file translation main page.
}}
<div class="local_deepler-files-container" id="local_deepler_files_container" data-courseid="{{courseid}}">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>{{coursename}}</h3>
        {{#hasfiles}}
        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-outline-secondary mr-2" data-action="files-select-all">
                {{str_selectall}}
            </button>
            <button type="button" class="btn btn-primary" data-action="files-translate-selected" disabled>
                <i class="fa-solid fa-language mr-1"></i> {{str_translateselected}}
            </button>
        </div>
        {{/hasfiles}}
    </div>

    {{^hasfiles}}
    <div class="alert alert-info" role="alert">
        {{str_empty}}
    </div>
    {{/hasfiles}}

    {{#hasfiles}}
    <div class="files-sections">
        {{#sections}}
            {{> local_deepler/files_section }}
        {{/sections}}
    </div>
    {{/hasfiles}}
</div>
